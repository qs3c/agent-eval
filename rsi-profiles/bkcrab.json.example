{
  "repository": "/home/xavier/Desktop/github/bkcrab",
  "parent_ref": "HEAD",
  "adapter": {
    "argv": ["/absolute/path/to/your-rsi-adapter"],
    "version": "set-an-explicit-adapter-model-and-prompt-version",
    "timeout_seconds": 1800,
    "pass_env": ["RSI_API_KEY"]
  },
  "checks": [
    {"argv": ["go", "test", "./..."], "timeout_seconds": 1200}
  ],
  "build": {
    "argv": ["sh", "-c", "CGO_ENABLED=0 go build -trimpath -o \"$1/bkcrab-eval\" ./cmd/bkcrab-eval && \"$2\" -m agent_harness_eval.cli snapshot-bkcrab \"$PWD\" \"$1/bkcrab-eval\" \"$1/bkcrab-provenance.json\"", "rsi-build", "{output}", "{python}"],
    "timeout_seconds": 1200
  },
  "artifacts": {"binary": "bkcrab-eval", "provenance": "bkcrab-provenance.json"},
  "evaluation": "../experiments/swe-live-bkcrab-corrected.json",
  "github_repository": null,
  "pr_base": "main"
}
